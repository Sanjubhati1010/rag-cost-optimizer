# ==============================================================================
# RAG Cost Optimizer - Environment Configuration Template
# All features operate 100% locally with zero external commercial API costs.
# Copy this file to '.env' before running: cp .env.example .env
# ==============================================================================

# Application Settings
DEBUG=false

# Semantic Caching Layer (Phase 2)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.90

# Cost-Aware Intelligent Routing (Phase 3)
COST_ROUTING_ENABLED=true
SMALL_MODEL=llama3.2:3b
LARGE_MODEL=mistral:7b
SIMPLE_THRESHOLD=3
COMPLEX_THRESHOLD=7

# Local Ollama Inference Engine
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=180.0
